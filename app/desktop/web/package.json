{
  "name": "betterlinuxcnc-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6522 --strictPort",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run check && vite build && tsc -p tsconfig.electron.json",
    "desktop": "electron .",
    "test:protocol": "node --test dist-electron/electron/*.test.js",
    "test:ui": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "package": "electron-builder --dir --linux --x64"
  },
  "dependencies": {
    "@lucide/vue": "1.73.0",
    "@vueuse/core": "15.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.45",
    "json-dup-key-validator": "1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "@types/node": "24.10.1",
    "vue-tsc": "3.3.14",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "@playwright/test": "1.65.1"
  },
  "main": "dist-electron/electron/main.js",
  "license": "GPL-2.0-or-later",
  "build": {
    "appId": "org.betterlinuxcnc.desktop",
    "productName": "BetterLinuxCNC",
    "executableName": "betterlinuxcnc-desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "!node_modules/node-pty/prebuilds/**",
      "!node_modules/node-pty/build/node_gyp_bins/**",
      "package.json",
      "SHADCN-LICENSE",
      "shadcn-source.json"
    ],
    "extraFiles": [{ "from": "../LICENSE", "to": "LICENSE" }],
    "linux": {
      "target": "dir",
      "category": "Utility"
    },
    "asarUnpack": ["node_modules/node-pty/build/Release/pty.node"],
    "asar": true
  }
}
