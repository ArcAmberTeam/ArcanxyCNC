// Permit only the three fixed axis-setting jobs, before legacy isolation rules.
polkit.addRule(function(action, subject) {
    if (subject.user === "linuxcnc"
        && action.id === "org.freedesktop.systemd1.manage-units"
        && action.lookup("verb") === "start"
        && ["betterlinuxcnc-axis-profile@3.service",
            "betterlinuxcnc-axis-profile@4.service",
            "betterlinuxcnc-axis-profile@5.service"].indexOf(action.lookup("unit")) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
